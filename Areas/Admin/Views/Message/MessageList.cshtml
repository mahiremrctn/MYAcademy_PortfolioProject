@model List<MYAcademy_PortfolioProject.Entities.Message>
@{
    ViewData["Title"] = "MessageList";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container">
    <br/>
    <table class="table table-bordered">
        <tr>
            <th>#</th>
            <th>Gönderen</th>
            <th>Konu</th>
            <th>Tarih</th>
            <th>Mesajı Aç</th>
        </tr>
    </table>
    @foreach (var item in Model)
    {
        <table class="table table-bordered">
            <tr>
                <td>@item.MessageId</td>
                <td>@item.SenderName</td>
                <td>@item.Subject</td>
                <td>@item.SendDate.ToString("dd/MM/yyyy")</td>
                <td><a href="/Admin/Message/MessageDetail/@item.MessageId class="btn btn-info">Mesajı Aç</a></td>
            </tr>
        </table>
}
)
