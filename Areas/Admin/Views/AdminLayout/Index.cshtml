@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
@await Component.InvokeAsync("_AdminLayoutHeadComponentPartial")
<body>

<div class="admin-wrapper">

  <!-- ==================== 1. LEFT SIDEBAR ==================== -->
        @await Component.InvokeAsync("_AdminLayoutSidebarComponentPartial")

  <!-- ==================== 2. MAIN CONTENT AREA ==================== -->
  <div class="admin-main">
    
    <!-- TOP NAVBAR -->
        @await Component.InvokeAsync("_AdminLayoutNavbarComponentPartial")

    <!-- CONTENT BODY -->
   @RenderBody()
  </div>
</div>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/delete-confirm.js"></script>
    <div id="notification" data-success="@TempData["SuccessMessage"]" data-error="@TempData["ErrorMessage"]"></div>
    <script src="~/js/notification.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    @await Component.InvokeAsync("_AdminLayoutScriptComponentPartial")
</body>
</html>

