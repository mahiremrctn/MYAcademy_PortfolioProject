@model Project
@{
    ViewData["Title"] = "Proje Güncelle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}
<div class="container">
    <h4>Projeyi Güncelle</h4>
    <form method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="ProjectId" />
        <div class="mb-3">
            <label asp-for="ProjectTitle" class="form-label">Proje Adı</label>
            <input asp-for="ProjectTitle" class="form-control" />
            <span asp-validation-for="ProjectTitle" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label">Açıklama</label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Technologies" class="form-label">Teknolojiler</label>
            <input asp-for="Technologies" class="form-control" placeholder="Örn: C#, ASP.NET Core, SQL" />
            <span asp-validation-for="Technologies" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="CategoryId" class="form-label">Kategori</label>
            <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                <option value="0">-- Kategori seçiniz --</option>
            </select>
            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label for="imageFile" class="form-label">Proje Görseli</label>
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div class="mb-2">
                    <img src="@Model.ImageUrl" alt="Mevcut görsel" class="project-thumb" />
                    <small class="text-muted ms-2">Değiştirmek için yeni bir dosya seçin.</small>
                </div>
            }
            <input type="hidden" asp-for="ImageUrl" />
            <input type="file" name="imageFile" id="imageFile" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
            @Html.ValidationMessage("imageFile", null, new { @class = "text-danger" })
        </div>
        <div class="form-check mb-3">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label">Aktif</label>
        </div>
        <button type="submit" class="btn btn-primary">Projeyi Güncelle</button>
    </form>
</div>