@model List<Project>
@{
    ViewData["Title"] = "Project List";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}
<div class="container">
    <br />
    <a asp-action="CreateProject" class="fab-add" title="Yeni Proje Ekle" aria-label="Yeni Proje Ekle">
        <i class="bi bi-plus-lg"></i>
    </a>
    <table class="table table-bordered">
        <tr>
            <th>#</th>
            <th>Görsel</th>
            <th>Proje Adı</th>
            <th>Kategori</th>
            <th>Teknolojiler</th>
            <th>Eklenme Tarihi</th>
            <th>Durum</th>
            <th>İşlemler</th>
        </tr>
        @foreach (var project in Model)
        {
            <tr>
                <td>@project.ProjectId</td>
                <td>
                    @if (!string.IsNullOrEmpty(project.ImageUrl))
                    {
                        <img src="@project.ImageUrl" alt="@project.ProjectTitle" class="project-thumb" />
                    }
                    else
                    {
                        <span class="text-muted">Görsel yok</span>
                    }
                </td>
                <td>@project.ProjectTitle</td>
                <td>@project.Category?.CategoryName</td>
                <td>@project.Technologies</td>
                <td>@project.CreatedDate.ToString("dd.MM.yyyy")</td>
                <td>
                    @if (project.IsActive)
                    {
                        <span class="badge bg-success">Aktif</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Pasif</span>
                    }
                </td>
                <td>
                    <a asp-action="UpdateProject" asp-route-id="@project.ProjectId" class="btn btn-sm btn-success">Güncelle</a>
                    <form asp-action="DeleteProject" asp-route-id="@project.ProjectId" method="post" style="display:inline;"
                          class="delete-form" data-message="Bu proje kalıcı olarak silinecek.">
                        <button type="submit" class="btn btn-sm btn-danger">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </table>
</div>
