@model List<Category>
@{
    ViewData["Title"] = "Category List";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}
<div>
    <a asp-action="CreateCategory" class="fab-add" title="Yeni Kategori Ekle" aria-label="Yeni Kategori Ekle">
        <i class="bi bi-plus-lg"></i>
    </a>
    <table class="table table-bordered">
    <tr>
        <th>#</th>
        <th>Kategori Adı</th>
        <th>İşlemler</th>
    </tr>
    @foreach (var category in Model)
    {
        <tr>
            <td>@category.CategoryId</td>
            <td>@category.CategoryName</td>
                <td>
                    <a asp-action="UpdateCategory" asp-route-id="@category.CategoryId" class="btn btn-sm btn-success">Güncelle</a>
                    <form asp-action="DeleteCategory" asp-route-id="@category.CategoryId" method="post" style="display:inline;"
                          class="delete-form" data-message="Bu kategori kalıcı olarak silinecek.">
                        <button type="submit" class="btn btn-sm btn-danger">Sil</button>
                    </form>
                </td>
            
        </tr>
        }
</table>
</div>