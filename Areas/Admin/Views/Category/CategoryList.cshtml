@model List<Category>
@{
    ViewData["Title"] = "Category List";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}
<div>
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }
    <table class="table table-bordered">
    <tr>
        <th>#</th>
        <th>Kategori Adı</th>
        <th>İşlemler</th>
    </tr>
    @foreach (var category in Model)
    {
        <tr>
            <td>@category.CategoryId</td>
            <td>@category.CategoryName</td>
                <td>
                    <a asp-action="UpdateCategory" asp-route-id="@category.CategoryId" class="btn btn-sm btn-success">Güncelle</a><form asp-action="DeleteCategory" asp-route-id="@category.CategoryId" method="post" style="display:inline;" onsubmit="return confirm('Bu kategoriyi silmek istediğinize emin misiniz?');">
                        <button type="submit" class="btn btn-sm btn-danger">Sil</button>
                    </form>
                </td>
            
        </tr>
        }
</table>
</div>